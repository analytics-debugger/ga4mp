{
  "name": "ga4mp",
  "version": "1.0.0-beta.0",
  "description": "A TypeScript/JavaScript library for Google Analytics 4 Measurement Protocol (GA4MP) tracking",
  "type": "module",
  "main": "dist/ga4mp.umd.js",
  "module": "dist/ga4mp.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/ga4mp.es.js",
      "require": "./dist/ga4mp.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:es5",
    "build:es5": "vite build --config vite.es5.config.ts",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "google",
    "analytics",
    "ga4",
    "measurement-protocol",
    "tracking",
    "javascript",
    "typescript"
  ],
  "author": "David Vallejo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@types/node": "^24.2.1",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "oxlint": "^1.10.0",
    "terser": "^5.43.1",
    "typescript": "~5.8.3",
    "vite": "npm:rolldown-vite@latest",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "vite-plugin-dts": "^4.5.4"
  }
}
